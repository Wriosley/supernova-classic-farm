# Copy to .env for local overrides. These values are for local development only.
# Never commit a real .env file. Fill MYSQL_PASSWORD locally; do not put secrets here.
APP_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

WEB_PORT=1616
LOGIN_PORT=18080
GATE_PORT=8081
LOGIN_PROXY_TARGET=http://CLB_IP:8080
GATE_PROXY_TARGET=ws://CLB_IP:8081
ZONE_PORT=8082
COORDINATOR_PORT=8083
ZONE_B_PORT=8084

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=classicfarm
MYSQL_USER=classicfarm
MYSQL_PASSWORD=classicfarm
H5_ORIGIN=http://WEB_FRONTEND_MACHINE_IP:1616

# Optional: construct yourself for ad-hoc shells. Prefer the fields above for the test runner.
# MYSQL_DSN=

# TcaplusDB PlayerCheckpoint POC. Keep TCAPLUS_SIGNATURE local and never commit it.
TCAPLUS_APP_ID=224
TCAPLUS_ZONE_ID=8888
TCAPLUS_DIR_URL=tcp://TCAPLUS_DB_MACHINE_IP:9999
TCAPLUS_SIGNATURE=
TCAPLUS_CHECKPOINT_TABLE=PlayerCheckpoint
TCAPLUS_POC_PLAYER_ID=90000001

TZ=
