# Copy to .env for local overrides. These values are for local development only.
APP_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

WEB_PORT=5173
LOGIN_PORT=8080
GATE_PORT=8081
ZONE_PORT=8082
COORDINATOR_PORT=8083

MYSQL_PORT=3306
MYSQL_DATABASE=classicfarm
MYSQL_USER=classicfarm
MYSQL_PASSWORD=classicfarm
MYSQL_ROOT_PASSWORD=classicfarm-root
MYSQL_DSN=classicfarm:classicfarm@tcp(127.0.0.1:3306)/classicfarm?charset=utf8mb4&parseTime=true&loc=Local

TZ=Asia/Shanghai
